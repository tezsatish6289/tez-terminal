# Copy to `.env.local` for local dev (never commit `.env.local`).

# Microsoft Clarity — FNONINJA session replay / heatmaps (public project ID).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Required to toggle "FreedomBot public" (Live / Hidden) in simulator bot config.
# Generate: openssl rand -base64 32
PUBLIC_LIVE_PASSPHRASE=

# Resend — FNO Ninja SR-audit win-story marketing Broadcasts (after Buffer post).
# Use a Full-access API key (not send-only). Segment = "FNO Ninja Updates".
# RESEND_SR_AUDIT_EMAIL=false disables blasts without removing keys.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_FROM=FNO Ninja <hello@updates.fnoninja.com>
RESEND_SR_AUDIT_EMAIL=true
