{
  "rules": {
    "rooms": {
      "$roomId": {
        "messages": {
          ".read": "auth != null && root.child('members').child(auth.uid).child('canChat').val() === true",
          ".write": false,
          ".indexOn": ["createdAt"]
        },
        "meta": {
          ".read": "auth != null && root.child('members').child(auth.uid).child('canChat').val() === true",
          ".write": false
        }
      }
    },
    "presence": {
      "$roomId": {
        ".read": "auth != null && root.child('members').child(auth.uid).child('canChat').val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).child('canChat').val() === true"
        }
      }
    },
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "live_alerts": {
      "success_stories": {
        ".read": true,
        ".write": false,
        ".indexOn": ["at"]
      },
      "score": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false,
          ".indexOn": ["at"]
        }
      }
    }
  }
}
