
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is the designated terminal admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == "hello@tezterminal.com";
    }

    // Community chat read gate: signed-in subscriber whose mirrored
    // chat_members doc says canChat. Writes are always server-only (Admin SDK),
    // so this is purely a read gate.
    function canChat() {
      return request.auth != null
        && exists(/databases/$(database)/documents/chat_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/chat_members/$(request.auth.uid)).data.canChat == true;
    }

    // Signals (Idea Stream)
    match /signals/{document=**} {
      allow read: if true; 
      allow create: if true; 
      allow update: if true; 
      allow delete: if isAdmin();
    }

    // Webhook Configurations
    match /webhooks/{webhookId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Sentiment signals from external indicators
    match /sentiment_signals/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // App Configuration (sentiment K value, thresholds, etc.)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cron heartbeats (server-written; client reads via Admin API on /simulation)
    match /cron_health/{jobId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // Logs: Technical audit trail.
    match /logs/{logId} {
      allow list, get: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Users: only the owning user can read their own doc from the client.
    // Server-side Admin SDK bypasses these rules entirely.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Telegram preferences: only the owning user can read/write from the client.
    match /telegram_preferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Telegram link tokens: client needs to create these (from the settings page).
    // Reading/deleting is handled server-side via Admin SDK.
    match /telegram_link_tokens/{tokenId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Signal events: readable by any authenticated user (Live Updates pane).
    match /signal_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tracked signals: per-user per-signal opt-in for TP/SL updates.
    match /tracked_signals/{trackId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Subscriptions: user can read their own, server handles writes.
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Payments: user can read their own payments, server handles writes.
    match /payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Referral commissions: referrer can read their own, server handles writes.
    match /referral_commissions/{commissionId} {
      allow read: if request.auth != null
        && resource.data.referrerId == request.auth.uid;
      allow write: if false;
    }

    // Referral payouts: referrer can read their own, server handles writes.
    match /referral_payouts/{payoutId} {
      allow read: if request.auth != null
        && resource.data.referrerId == request.auth.uid;
      allow write: if false;
    }

    // Simulator trades: readable by authenticated users, server handles writes.
    match /simulator_trades/{tradeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Simulator logs: readable by authenticated users, server handles writes.
    match /simulator_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Live trades: only the owning user can read from the client.
    match /live_trades/{tradeId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    // Live trade logs: only the owning user can read from the client.
    match /live_trade_logs/{logId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Twitter agent data — server-only via Admin SDK
    match /twitter_config/{docId} {
      allow read, write: if false;
    }
    match /twitter_posted/{docId} {
      allow read, write: if false;
    }
    match /twitter_processed/{docId} {
      allow read, write: if false;
    }

    // Community chat — durable archive. Live stream is in RTDB; Firestore holds
    // the searchable/paginated history and is written server-side via Admin SDK.
    match /chat_rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if canChat();
        allow write: if false;
      }
    }

    // Chat membership/gate mirror: each user can read their own (canChat, ban,
    // terms). Server (Admin SDK) is the only writer.
    match /chat_members/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Chat reports: any signed-in user can file a report; reads/edits are
    // server-only (admin moderation queue).
    match /chat_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // RBAC — role definitions and per-user role assignments.
    // Server-only: written by the access-control admin UI via Admin SDK,
    // read on every admin API request via requireAdmin() in src/lib/admin-auth.ts.
    // Client SDK is intentionally locked out so admins cannot self-elevate.
    match /admin_roles/{roleId} {
      allow read, write: if false;
    }
    match /admin_user_roles/{userId} {
      allow read, write: if false;
    }
  }
}
