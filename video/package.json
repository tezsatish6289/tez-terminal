{
  "name": "fnoninja-video",
  "private": true,
  "version": "0.1.0",
  "description": "Automated daily FNONINJA options-cluster short videos (Remotion).",
  "scripts": {
    "studio": "remotion studio",
    "render:put": "remotion render ClusterPut out/put-cluster.mp4",
    "render:call": "remotion render ClusterCall out/call-cluster.mp4",
